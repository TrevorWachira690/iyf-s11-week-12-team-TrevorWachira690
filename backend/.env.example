# MongoDB connection string
# Local: mongodb://localhost:27017/community-hub
# Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/community-hub
MONGO_URI=

# JWT secret for signing tokens (use a strong random string in production)
JWT_SECRET=

# Server port (defaults to 5000 if not set)
PORT=5000

# Environment (development, production, test)
NODE_ENV=development

# Frontend URL(s) allowed for CORS (comma-separated)
CLIENT_URL=http://localhost:5173

# Google OAuth (optional - leave blank if not using)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
